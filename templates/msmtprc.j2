# {{ ansible_managed }}

# Default settings that all accounts inherit
defaults
auth           on
tls            on
tls_starttls   {{ msmtp_tls_starttls }}
tls_trust_file {{ msmtp_tls_trust_file }}

# Logging
{% if msmtp_log == "syslog" %}
syslog {{ msmtp_syslog_facility }}
{% elif msmtp_log == "file" %}
logfile {{ msmtp_logfile }}
{% endif %}

# EHLO/HELO domain
domain {{ msmtp_domain }}
# Do not generate an envelope-from address of the form user@domain
auto_from off
{% if msmtp_set_from_header | length > 0 and _msmtp_version is version('1.8.8', '>=') %}
# Replace/add the From header with the account's from address
set_from_header {{ msmtp_set_from_header }}
{% endif %}

{% for msmtp_account in msmtp_accounts %}
#
account  {{ msmtp_account.account }}
host     {{ msmtp_account.host }}
port     {{ msmtp_account.port }}
auth     {{ msmtp_account.auth }}
from     {{ msmtp_account.from }}
{% if msmtp_account.from_full_name is defined and _msmtp_version is version('1.8.24', '>=') %}
from_full_name "{{ msmtp_account.from_full_name }}"
{% endif %}
{% if msmtp_account.user is defined %}
user     {{ msmtp_account.user }}
{% endif %}
{% if msmtp_account.password is defined %}
password {{ msmtp_account.password }}
{% endif %}
{% if msmtp_account.tls is defined %}
tls      {{ msmtp_account.tls }}
{% endif %}
{% if msmtp_account.tls_starttls is defined %}
tls_starttls {{ msmtp_account.tls_starttls }}
{% endif %}
{% endfor %}

# Default account to use
account default : {{ msmtp_default_account }}

aliases /etc/aliases
